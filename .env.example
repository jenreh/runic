# ─────────────────────────────────────────────────────────────────────────────
# runic.rag — Graph-RAG SDK configuration
#
# Copy to `.env` and fill in secrets. All RUNIC_RAG_* vars are read by
# `runic.rag.config.RagSettings` (pydantic-settings). OPENAI_API_KEY /
# OLLAMA_BASE_URL are consumed directly by the LLM/embedding client.
#
#   cp .env.example .env  &&  edit .env
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM provider (extraction + answer synthesis) ────────────────────────────
# provider: "openai" (default) | "ollama"
RUNIC_RAG_LLM_PROVIDER=openai
RUNIC_RAG_LLM_MODEL=gpt-5.4-nano

# ── Embeddings ───────────────────────────────────────────────────────────────
RUNIC_RAG_EMBEDDING_PROVIDER=openai
RUNIC_RAG_EMBEDDING_MODEL=text-embedding-3-small
RUNIC_RAG_EMBEDDING_DIM=1536
# Max texts per embed_batch request during ingestion (<=0 → one request).
RUNIC_RAG_EMBED_BATCH_SIZE=128

# ── Provider credentials / endpoints ─────────────────────────────────────────
# Required when provider=openai. Consumed directly by the OpenAI client.
OPENAI_API_KEY=sk-replace-me
# Optional OpenAI-compatible base URL (leave blank for api.openai.com).
# RUNIC_RAG_OPENAI_BASE_URL=

# Opt-in local provider. Set RUNIC_RAG_LLM_PROVIDER=ollama and pull the models:
#   ollama pull qwen2.5   &&   ollama pull nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434/v1
# When provider=ollama, suggested values:
#   RUNIC_RAG_LLM_MODEL=qwen2.5
#   RUNIC_RAG_EMBEDDING_MODEL=nomic-embed-text
#   RUNIC_RAG_EMBEDDING_DIM=768

# ── Graph backend ────────────────────────────────────────────────────────────
# Any runic-supported Cypher backend works:
#   falkordb (default) | neo4j   → native vector + fulltext search
#   memgraph | arcadedb | age    → portable brute-force vector + fulltext
RUNIC_RAG_BACKEND=falkordb
RUNIC_RAG_FALKORDB_HOST=localhost
RUNIC_RAG_FALKORDB_PORT=6379
RUNIC_RAG_FALKORDB_GRAPH=runic_rag

# Neo4j (set RUNIC_RAG_BACKEND=neo4j to use). Native indexes created on bootstrap.
# RUNIC_RAG_NEO4J_URI=bolt://localhost:7687
# RUNIC_RAG_NEO4J_USERNAME=neo4j
# RUNIC_RAG_NEO4J_PASSWORD=
# RUNIC_RAG_NEO4J_DATABASE=neo4j

# Memgraph (Bolt). Uses the portable brute-force retrieval path.
# RUNIC_RAG_MEMGRAPH_URI=bolt://localhost:7688
# RUNIC_RAG_MEMGRAPH_USERNAME=
# RUNIC_RAG_MEMGRAPH_PASSWORD=
# RUNIC_RAG_MEMGRAPH_DATABASE=memgraph

# ArcadeDB (Bolt). Brute-force retrieval; create the database first.
# RUNIC_RAG_ARCADEDB_HOST=localhost
# RUNIC_RAG_ARCADEDB_PORT=2424
# RUNIC_RAG_ARCADEDB_DATABASE=runic_rag
# RUNIC_RAG_ARCADEDB_USERNAME=root
# RUNIC_RAG_ARCADEDB_PASSWORD=

# Apache AGE (PostgreSQL + AGE). Brute-force retrieval; no Cypher-level index DDL.
# RUNIC_RAG_AGE_HOST=localhost
# RUNIC_RAG_AGE_PORT=5432
# RUNIC_RAG_AGE_DATABASE=postgres
# RUNIC_RAG_AGE_GRAPH=runic_rag
# RUNIC_RAG_AGE_USERNAME=postgres
# RUNIC_RAG_AGE_PASSWORD=

# ── Chunking ─────────────────────────────────────────────────────────────────
RUNIC_RAG_CHUNK_SIZE=1200
RUNIC_RAG_CHUNK_OVERLAP=200

# ── Entity resolution (§9.3) ─────────────────────────────────────────────────
RUNIC_RAG_RESOLVE_THRESHOLD=0.92
RUNIC_RAG_TIEBREAK_LOW=0.82
RUNIC_RAG_TIEBREAK_HIGH=0.92
RUNIC_RAG_LLM_TIEBREAK=false

# ── Concurrency & rate limiting (§9.4) ───────────────────────────────────────
RUNIC_RAG_CONCURRENCY=8
RUNIC_RAG_REQUESTS_PER_MINUTE=0

# ── Cost control (§9.5) — 0 means unlimited ──────────────────────────────────
RUNIC_RAG_MAX_LLM_CALLS=0
RUNIC_RAG_MAX_TOKENS=0
RUNIC_RAG_GLEANING_PASSES=0
RUNIC_RAG_CACHE_DIR=.cache/runic-rag

# ── Retrieval (§9.6) ─────────────────────────────────────────────────────────
RUNIC_RAG_MAX_HOPS=2
RUNIC_RAG_TOP_K=10
